%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65c1e57ecaf14b7d817871b1e23ec21d, type: 3}
  m_Name: DialogueTable
  m_EditorClassIdentifier: 
  lines:
  - dialogueId: template_dialogue_accept
    lineIndex: 0
    speakerName: "\u6751\u957F"
    text: "太好了。请去森林边的小屋找回项链。"
    portraitResource:
    standingResource:
    expression: happy
    style: 0
    autoPlayDelay: 1.2
    options: []
  - dialogueId: template_dialogue_decline
    lineIndex: 0
    speakerName: "\u6751\u957F"
    text: "我明白了。如果你改变主意，可以再来找我。"
    portraitResource:
    standingResource:
    expression: sad
    style: 0
    autoPlayDelay: 1.2
    options: []
  - dialogueId: template_dialogue_persuade
    lineIndex: 0
    speakerName: "\u6751\u957F"
    text: "你的话让我安心。好吧，我会先付一半报酬。"
    portraitResource:
    standingResource:
    expression: moved
    style: 0
    autoPlayDelay: 1.2
    options: []
  - dialogueId: template_dialogue_reward
    lineIndex: 0
    speakerName: "\u6751\u957F"
    text: "我会给你 50 枚金币，还有村里的通行证明。"
    portraitResource: 
    standingResource: 
    expression: normal
    style: 0
    autoPlayDelay: 1.2
    options: []
  - dialogueId: template_dialogue_test_001
    lineIndex: 0
    speakerName: "\u6751\u957F"
    text: "你好，{playerName}。你真的要进入<color=red>禁地</color>吗？"
    portraitResource: 
    standingResource: 
    expression: normal
    style: 0
    autoPlayDelay: 1.2
    options:
    - text: "当然愿意"
      nextDialogueId: template_dialogue_accept
      condition: '!quest:necklace=accepted;!quest:necklace=ready;!quest:necklace=completed'
      effects: quest:necklace=accepted;add:favor.oldman=1
    - text: "我没空"
      nextDialogueId: template_dialogue_decline
      condition: '!quest:necklace=accepted;!quest:necklace=ready;!quest:necklace=completed'
      effects: add:favor.oldman=-1
    - text: "你先告诉我报酬"
      nextDialogueId: template_dialogue_reward
      condition: '!quest:necklace=accepted;!quest:necklace=ready;!quest:necklace=completed'
      effects: 
    - text: "[魅力 5] 说服他"
      nextDialogueId: template_dialogue_persuade
      condition: charm>=5;!quest:necklace=accepted;!quest:necklace=ready;!quest:necklace=completed
      effects: add:favor.oldman=2
    - text: "我还没找到项链"
      nextDialogueId: template_dialogue_progress
      condition: quest:necklace=accepted
      effects:
    - text: "模拟：在小屋找到项链"
      nextDialogueId: template_dialogue_found
      condition: quest:necklace=accepted
      effects: item:necklace;quest:necklace=ready
    - text: "把项链交给村长"
      nextDialogueId: template_dialogue_complete
      condition: quest:necklace=ready;item:necklace
      effects: quest:necklace=completed;removeItem:necklace;add:favor.oldman=3
    - text: "询问完成后的反应"
      nextDialogueId: template_dialogue_completed
      condition: quest:necklace=completed
      effects:
  - dialogueId: template_dialogue_test_001
    lineIndex: 1
    speakerName: 
    text: "风穿过村口的木牌，旧铃发出轻轻的响声。"
    portraitResource:
    standingResource:
    expression: 
    style: 1
    autoPlayDelay: 1.4
    options: []
  - dialogueId: template_dialogue_test_001
    lineIndex: 2
    speakerName: "\u52C7\u8005"
    text: "如果这是命运给我的测试，那我至少要确认对话系统能正常工作。"
    portraitResource:
    standingResource:
    expression: thinking
    style: 2
    autoPlayDelay: 1.6
    options: []
  - dialogueId: template_dialogue_test_001
    lineIndex: 3
    speakerName: 
    text: "系统提示：这段对话来自 DialogueTable，可通过 Excel 导入工具刷新。"
    portraitResource:
    standingResource:
    expression: 
    style: 3
    autoPlayDelay: 1.2
    options: []
  - dialogueId: template_dialogue_progress
    lineIndex: 0
    speakerName: "\u6751\u957F"
    text: "项链应该还在森林边的小屋附近。找到后再回来找我吧。"
    portraitResource:
    standingResource:
    expression: normal
    style: 0
    autoPlayDelay: 1.2
    options: []
  - dialogueId: template_dialogue_found
    lineIndex: 0
    speakerName: "\u52C7\u8005"
    text: "你在小屋旁找到了那条旧项链。现在可以回去交给村长。"
    portraitResource:
    standingResource:
    expression: normal
    style: 0
    autoPlayDelay: 1.2
    options: []
  - dialogueId: template_dialogue_complete
    lineIndex: 0
    speakerName: "\u6751\u957F"
    text: "没错，就是这条项链。谢谢你，这份人情我会记住。"
    portraitResource:
    standingResource:
    expression: happy
    style: 0
    autoPlayDelay: 1.2
    options: []
  - dialogueId: template_dialogue_completed
    lineIndex: 0
    speakerName: "\u6751\u957F"
    text: "你已经帮我找回项链了。如果需要村里帮忙，尽管开口。"
    portraitResource:
    standingResource:
    expression: happy
    style: 0
    autoPlayDelay: 1.2
    options: []
